{
  "manifest_version": 1,
  "engine": {
    "id": "bing_images",
    "name": "Bing Images",
    "author": "RAT System",
    "version": "1.5",
    "description": "Scraper for Bing Image Search (Duplicate Fix)"
  },
  "request": {
    "baseUrl": "https://www.bing.com/images/search",
    "params": {
      "query": "q",
      "country": "cc",
      "language": "setLang"
    },
    "features": {
      "requiresUuleEncoding": false,
      "urlDecodingMethod": "none",
      "disableScreenshots": true
    },
    "supportedCountries": [
      { "code": "au", "name": "Australia" },
      { "code": "at", "name": "Austria" },
      { "code": "be", "name": "Belgium" },
      { "code": "ca", "name": "Canada" },
      { "code": "fr", "name": "France" },
      { "code": "de", "name": "Germany" },
      { "code": "ie", "name": "Ireland" },
      { "code": "it", "name": "Italy" },
      { "code": "nl", "name": "Netherlands" },
      { "code": "nz", "name": "New Zealand" },
      { "code": "es", "name": "Spain" },
      { "code": "ch", "name": "Switzerland" },
      { "code": "gb", "name": "United Kingdom" },
      { "code": "us", "name": "USA" }
    ],
    "supportedLanguages": [
      { "code": "en", "name": "English" },
      { "code": "de", "name": "German" },
      { "code": "fr", "name": "French" },
      { "code": "it", "name": "Italian" },
      { "code": "es", "name": "Spanish" },
      { "code": "nl", "name": "Dutch" }
    ]
  },
  "behavior": {
    "cookieConsentSelectors": [],
    "popupDismissSelectors": [],
    "aiExpandSelectors": []
  },
  "captcha": {
    "urlIndicators": [ "/checkpoint", "showcheck" ],
    "textIndicators": [],
    "selectors": [ ".g-recaptcha", "#recaptcha", "#b_captcha" ]
  },
  "selectors": {
    "pagination": {
      "type": "infinite_scroll",
      "nextButton": "a.btn_seemore, .mm_seemore, .mUI_b_btn, #b_moreItems"
    },
    "images": {
      "mainCol": null,
      "container": ".iuscp, .dg_u",
      "excludeContainers": [
        ".shoptiles", 
        ".shop", 
        "[class*='shop']", 
        "[data-tag*='shop']", 
        ".rich-badge", 
        ".offer",
        ".carousel"
      ],
      "title": ".infpd a, .infnmpt a, .info, .fileinfo",
      "url": ".lnkw a, a.iusc, a.inflnk",
      "image": "img.mimg, img.rms_img, img",
      "snippet": { "selector": ".infsd, .infpd", "minLength": 0 }
    },
    "organic": null,
    "ads": { "container": ".b_ad", "title": null, "url": null, "snippet": { "selector": null } },
    "ai_overview": { "container": null, "text": null, "inline_citations": { "selector": null }, "sources": null }
  }
}