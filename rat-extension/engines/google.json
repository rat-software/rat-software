        "selector": ".WBgIic, .DHPVt, a.H23r4e, a.PMDqCb, sup, a[data-url], button[data-icl-uuid], button.vDOt8c",
        "urlAttribute": "href",
        "dataAttribute": "data-icl-uuid"
      },
      "sources": [
        {
          "type": "standard",
          "container": ".LLtSOc, .CyMdWb, .LT6XE [role=\"listitem\"], .pWvJNd [role=\"listitem\"], li.h7wxwc, .pWvJNd .h7wxwc",
          "title": ".QNca8b, .mNme1d, .Nn35F, .gpZmoc, .Hnm1Fe, a.vIWmYe, [aria-label]",
