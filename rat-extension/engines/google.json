  "behavior": {
    "cookieConsentSelectors": [ "#L2AGLb", "#W0wltc" ],
    "popupDismissSelectors": [ ".mcPPZ", ".qk7LXc", "minor-moment-dialog", "[role=\"dialog\"]" ],
    "popupDismissKeywords": [
      "ok", "confirm", "accept", "agree", "continue", "not now", "no thanks", "later", "reject",
      "bestätigen", "akzeptieren", "zustimmen", "fortfahren", "nicht jetzt", "nein danke", "später", "ablehnen", "pas maintenant"
    ],
    "aiExpandSelectors": [ ".in7vHe[role=\"button\"]", "div[role=\"button\"]", "button", "span[role=\"button\"]" ],
    "aiExpandKeywords": [
      "Mehr anzeigen", "Show more", "Mostrar más", "Afficher plus", "Mostra altro", "Meer weergeven", "Mostrar mais",
      "Mehr Quellen", "Alle anzeigen", "Show all", "Ver todo", "Tout afficher", "Visualizza tutto", "Alles weergeven",
      "Ver tudo", "ähnliche", "view related", "quellen", "sources", "weitere", "more", "fuentes", "fonti", "bronnen"
    ],
    "stickyHeaderSelectors": [
      "#searchform", ".sfbg", "header", "[style*=\"position: fixed\"]", "[style*=\"position: sticky\"]",
      ".LHJvCe", ".yg51vc", ".t2051c"
    ]
  },
  "captcha": {
    "urlIndicators": [ "/sorry/" ],
    "textIndicators": [ "unusual traffic", "ungewöhnlicher datenverkehr", "not a robot", "kein roboter" ],
    "selectors": [ "form[action*=\"Captcha\"]", ".g-recaptcha", "#recaptcha", "iframe[src*=\"recaptcha\"]" ]
  },
  "selectors": {
    "pagination": {
      "nextButton": "#pnnext",
      "fallbackUrlMath": "start=(\\d+)"
    },
    "organic": {
      "mainCol": "#main, #cnt, #rcnt, #center_col, #search, #rso",
      "container": ".tF2Cxc, .g",
      "excludeContainers": [ 
        ".related-question-pair", 
        ".wQiwMc", 
        "[jsname=\"yEVEwb\"]", 
        ".RzdJxc", 
        ".vZHw0e", 
        ".ct3b9e",
        ".vtSz8d",
        ".Tu1FGd",
        ".g:has(.J8kk3)", 
        ".g:has(a[href*='youtube.com/watch'])"
      ],
      "title": "h3",
      "url": "a",
      "snippet": { "selector": ".VwiC3b, .Uroaid, div[data-sncf=\"1\"], .s3v9rd", "minLength": 0 }
    },
    "ads": {
      "container": "[data-text-ad=\"1\"], .uEierd, .vdQmEd",
      "title": "[role=\"heading\"], h3",
      "url": "a",
      "snippet": { "selector": ".MUxGbd, .vsiJxb", "maxLength": 200 }
    },
    "videos": {
      "container": ".Tu1FGd, .RzdJxc, .vZHw0e, .V3FYNc, .ct3b9e, .g:has(.J8kk3), .g:has([aria-label*='Dauer']), .g:has(a[href*='youtube.com/watch']), .xrOenc, .ktTVvf",
      "title": ".cHaqb, .ZxS7Db, [role=\"heading\"], h3, .fcGjWe, .oz3bsb, .V5XKdd",
      "url": "a.rIRoqf, a.XVwoZ, a.vIWmYe, a",
      "channel": ".Sg4azc, cite, .pcJO7e, .FzXzMc, .Od5Jsd, .O3DxF, .REaq6c, .soPc9",
      "duration": ".c8rnLc, .J8kk3, .YGG51c, .B7GWhc, [aria-label*='Dauer']",
      "date": ".Foqdsf div span, .Zg10ld, .hDeAhf, .szxfL, .r0bn4c",
      "image": "img"
